<thead><tr id="_33b21e66-2436-8ba3-c17c-6a121d17d936" semx-id="_33b21e66-2436-8ba3-c17c-6a121d17d936"><th id="_a2a6a590-bbb1-088c-223c-cbb83cb340a3" valign="middle" align="left" semx-id="_a2a6a590-bbb1-088c-223c-cbb83cb340a3">Literal value</th>
<th id="_955d3689-251e-d453-89a2-5d4e385b6e6c" valign="middle" align="left" semx-id="_955d3689-251e-d453-89a2-5d4e385b6e6c">Definition</th>
