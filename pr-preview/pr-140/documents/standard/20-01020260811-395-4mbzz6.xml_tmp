<bibitem id="rfc3986" type="standard" schema-version="v1.5.6" anchor="rfc3986" semx-id="_69656314-723b-3f96-d01e-6ef2775e3e8a"><biblio-tag/><formattedref>Berners-Lee T, Fielding R, Masinter L: IETF RFC 3986, <em>Uniform Resource Identifier (URI): Generic Syntax</em>. RFC Publisher (2005). <fmt-link target="https://www.rfc-editor.org/info/rfc3986">https://www.rfc-editor.org/info/rfc3986</fmt-link>.</formattedref>
  <fetched>2026-08-11</fetched>
  
<title type="main">Uniform Resource Identifier (URI): Generic Syntax</title>

  <uri type="src">https://www.rfc-editor.org/info/rfc3986</uri>
  <docidentifier type="IETF" primary="true">IETF RFC 3986</docidentifier>
  <docidentifier type="DOI">DOI 10.17487/RFC3986</docidentifier><docidentifier scope="biblio-tag">IETF RFC 3986</docidentifier>
  <docnumber>RFC3986</docnumber>
  <date type="published">
    <on>2005-01</on>
  </date>
  <contributor>
    <role type="author"/>
