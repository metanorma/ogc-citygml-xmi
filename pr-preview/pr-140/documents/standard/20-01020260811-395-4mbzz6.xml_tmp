</td>
</tr><tr id="_9de9e4f1-4e18-6f97-4b12-c7f51c69a661" semx-id="_9de9e4f1-4e18-6f97-4b12-c7f51c69a661"><td id="_19d10fc2-59b0-009a-eac8-7107534799d5" valign="middle" align="left" semx-id="_19d10fc2-59b0-009a-eac8-7107534799d5"><p id="_219be6e1-81ca-8624-3907-fc540a36898e" semx-id="_219be6e1-81ca-8624-3907-fc540a36898e"><xref target="section-EAID_92951EA3_582A_46ad_B6FE_3DEB9045C16D" id="_429a397b-2e15-9c4c-b619-7716b48b99e5">LandUseUsageValue</xref><fmt-xref target="section-EAID_92951EA3_582A_46ad_B6FE_3DEB9045C16D">LandUseUsageValue</fmt-xref> «CodeList»</p>
