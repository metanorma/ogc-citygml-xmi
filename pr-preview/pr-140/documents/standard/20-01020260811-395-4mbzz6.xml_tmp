</td>
</tr><tr id="_9260f6e4-c69e-92a1-0320-0747875c0f40" semx-id="_9260f6e4-c69e-92a1-0320-0747875c0f40"><td id="_e1b334be-2d9e-94f1-5c0d-5795402a359c" valign="middle" align="left" semx-id="_e1b334be-2d9e-94f1-5c0d-5795402a359c"><p id="_a4f7c8d6-fd9d-6416-1b88-9774c6c04f99" semx-id="_a4f7c8d6-fd9d-6416-1b88-9774c6c04f99"><xref target="section-EAID_227F36A3_F59C_4cd3_8B52_2F7058F64ECF" id="_f48bc1a9-e714-a558-22c7-c07a98e36922">AbstractVersionTransition</xref><fmt-xref target="section-EAID_227F36A3_F59C_4cd3_8B52_2F7058F64ECF">AbstractVersionTransition</fmt-xref> «FeatureType»</p>
