<td id="_33cd5bf4-cced-92bc-0af8-6f73196cb768" valign="middle" align="left" semx-id="_33cd5bf4-cced-92bc-0af8-6f73196cb768"><sourcecode id="_f9597115-b5f4-6b3f-264b-e90aa984c5c0" lang="ocl" linenums="true" semx-id="_f9597115-b5f4-6b3f-264b-e90aa984c5c0"><body>boundary().notEmpty() implies boundary().dimension() = dimension() -1 (Invariant):</body><fmt-sourcecode lang="ocl" linenums="true" semx-id="_f9597115-b5f4-6b3f-264b-e90aa984c5c0" id="_21c09376-b4af-468c-e615-747f2d321c7c"><table class="rouge-line-table"><tbody><tr id="_f9597115-b5f4-6b3f-264b-e90aa984c5c0_line-1" class="lineno"><td class="rouge-gutter gl" style="-moz-user-select: none;-ms-user-select: none;-webkit-user-select: none;user-select: none;"><pre>1</pre></td><td class="rouge-code"><sourcecode><span class="n">boundary</span><span class="p">().</span><span class="nf">notEmpty</span><span class="p">()</span> <span class="o">implies</span> <span class="n">boundary</span><span class="p">().</span><span class="n">dimension</span><span class="p">()</span> <span class="o">=</span> <span class="n">dimension</span><span class="p">()</span> <span class="o">-</span><span class="mi">1</span> <span class="p">(</span><span class="n">Invariant</span><span class="p">):</span></sourcecode></td></tr></tbody></table></fmt-sourcecode></sourcecode> </td>
