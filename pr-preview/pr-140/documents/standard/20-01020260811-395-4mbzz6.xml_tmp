</tr><tr id="_43b8bdf4-938c-400e-5d0b-da6a69f0bb19" semx-id="_43b8bdf4-938c-400e-5d0b-da6a69f0bb19"><th id="_be668bf6-99cf-44f7-bb33-559b9222cf0b" valign="middle" align="left" semx-id="_be668bf6-99cf-44f7-bb33-559b9222cf0b">Stereotype:</th>
