<term id="term-GM_OrientableSurface" anchor="term-GM_OrientableSurface" semx-id="_6f8e7b8d-700a-1952-2d49-085641f96d47" autonum="B.1.2.24"><fmt-name id="_47f0dd33-19e3-6846-fb96-72bdad266741"><span class="fmt-caption-label">B<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>24<span class="fmt-autonum-delim">.</span></span></fmt-name><fmt-xref-label><span class="fmt-element-name">Annex</span> B<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>24</fmt-xref-label><preferred id="_741e754a-1390-7958-3c94-076625b70d96"><expression>
