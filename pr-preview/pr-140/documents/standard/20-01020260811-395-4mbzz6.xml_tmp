</expression>
</preferred><fmt-preferred><p><semx element="preferred" source="_741e754a-1390-7958-3c94-076625b70d96"><strong><semx element="expression/name" source="_a7b273e3-e03a-3895-bf3a-566379c2696e">GM_OrientableSurface</semx></strong></semx></p></fmt-preferred>
<definition id="_8ecd03c6-558c-8a07-3994-1eed18881ebf" semx-id="_8ecd03c6-558c-8a07-3994-1eed18881ebf"><verbal-definition semx-id="_79a0afd0-bb1b-52b9-5e3e-32b7ec05a5aa" id="_79a0afd0-bb1b-52b9-5e3e-32b7ec05a5aa"><p semx-id="_5c0f9a89-c4fa-e80f-c8c9-85b443e8590b" original-id="_5c0f9a89-c4fa-e80f-c8c9-85b443e8590b">A surface and an orientation inherited from GM_OrientablePrimitive. If the orientation is “+”, then the GM_OrientableSurface is a GM_Surface. If the orientation is “-”, then the GM_OrientableSurface is a reference to a GM_Surface with an upNormal that reverses the direction for this GM_OrientableSurface, the sense of “the top of the surface”.</p></verbal-definition></definition><fmt-definition id="_f88e3a8c-ae97-8d51-dc6f-fa4a46623101"><semx element="definition" source="_8ecd03c6-558c-8a07-3994-1eed18881ebf"><p id="_5c0f9a89-c4fa-e80f-c8c9-85b443e8590b" semx-id="_5c0f9a89-c4fa-e80f-c8c9-85b443e8590b">A surface and an orientation inherited from GM_OrientablePrimitive. If the orientation is “+”, then the GM_OrientableSurface is a GM_Surface. If the orientation is “-”, then the GM_OrientableSurface is a reference to a GM_Surface with an upNormal that reverses the direction for this GM_OrientableSurface, the sense of “the top of the surface”.</p></semx></fmt-definition>


 <source status="identical" type="authoritative" id="_241323bd-0b63-a514-7967-41a4c67c6bf0"><origin bibitemid="iso19107" type="inline" citeas="ISO 19107:2003"/></source><fmt-termsource status="identical" type="authoritative">[<strong>SOURCE:</strong> <semx element="source" source="_241323bd-0b63-a514-7967-41a4c67c6bf0"><origin bibitemid="iso19107" type="inline" citeas="ISO 19107:2003" id="_d93e9fd1-988b-6930-5663-7b37e959df00"/><semx element="origin" source="_d93e9fd1-988b-6930-5663-7b37e959df00"><fmt-xref type="inline" target="iso19107">ISO 19107:2003</fmt-xref></semx></semx>]</fmt-termsource></term>

