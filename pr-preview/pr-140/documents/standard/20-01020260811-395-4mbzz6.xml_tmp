  <language>en</language>
  <script>Latn</script>
  <abstract language="en" script="Latn">From ISO 19101, “A feature is an abstraction of a real world phenomenon”; it is a geographic feature if it is associated with a location relative to the Earth. </abstract>
</bibitem>
