<ul id="_063009cf-73ea-9dfb-8156-77e2d9077665" semx-id="_063009cf-73ea-9dfb-8156-77e2d9077665"><li id="_2661e6b2-3b2c-c1f3-035f-a836a9913ba5"><fmt-name id="_ac0c17ed-435c-e6ea-660f-2b02b12de4f6">•</fmt-name><p id="_91686f53-bc91-552d-a461-a368a22ff946" semx-id="_91686f53-bc91-552d-a461-a368a22ff946">Core::AbstractThematicSurface,</p>
</li>
<li id="_3d45b9e1-368f-3bd3-6d76-74757f4f9335"><fmt-name id="_030db1d0-c3a0-78d5-79db-c4da01cd3596">•</fmt-name><p id="_1f0abd11-55a2-d478-d762-412376de1ca6" semx-id="_1f0abd11-55a2-d478-d762-412376de1ca6">Core::ClosureSurface</p>
</li>
</ul>
</li>
<li id="_bd3a4e9a-5673-730f-3d04-87a6ed86949a"><fmt-name id="_1a8fbbbf-82b1-47ee-4040-a6d85a72ce04">•</fmt-name><p id="_6ce9fdb3-43d6-3c7a-a3a4-5cb8d6b0f84e" semx-id="_6ce9fdb3-43d6-3c7a-a3a4-5cb8d6b0f84e">Generics::GenericThematicSurface</p>
</li>
<li id="_c1a88a20-e3d6-c8c8-9520-bd1dd811a90a"><fmt-name id="_8610f40d-562d-3b2a-a537-d7936ace2098">•</fmt-name><p id="_3748022e-0568-cd28-e3eb-431e84bd1f98" semx-id="_3748022e-0568-cd28-e3eb-431e84bd1f98">possible classes from ADEs</p>
</li>
