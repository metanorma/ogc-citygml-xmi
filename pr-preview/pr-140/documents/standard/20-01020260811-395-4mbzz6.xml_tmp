  <contributor>
    <role type="author">
      <description>committee</description>
    </role>
    <organization>
      
<name>International Organization for Standardization</name>

      <subdivision type="technical-committee" subtype="TC">
        
<name>Geographic information/Geomatics</name>

        <identifier id="_e8a279ef-1a50-3061-fb63-766cf21e2784">ISO/TC 211</identifier><fmt-identifier><tt><semx element="identifier" source="_e8a279ef-1a50-3061-fb63-766cf21e2784">ISO/TC 211</semx></tt></fmt-identifier>
