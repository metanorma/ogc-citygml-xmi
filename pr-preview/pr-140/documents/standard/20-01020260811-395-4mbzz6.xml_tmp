<tbody><tr id="_b6432bd5-dead-da39-32cf-fcbe51ef47da" semx-id="_b6432bd5-dead-da39-32cf-fcbe51ef47da"><td id="_39cf6b5f-eea7-6b42-d502-aa01989b5556" valign="middle" align="left" semx-id="_39cf6b5f-eea7-6b42-d502-aa01989b5556"><p id="_3e8c0e86-0633-32b3-a8b6-15a3ababa196" semx-id="_3e8c0e86-0633-32b3-a8b6-15a3ababa196"><xref target="section-EAID_4661534F_B67D_46b5_BC56_CEED3792F85B" id="_5378a593-a183-44d0-14ac-441a0c3c26db">ADEOfAbstractConstruction</xref><fmt-xref target="section-EAID_4661534F_B67D_46b5_BC56_CEED3792F85B">ADEOfAbstractConstruction</fmt-xref> «DataType»</p>
</td>
<td id="_12ea25c9-8f8e-0c39-cf60-cac927861df2" valign="middle" align="left" semx-id="_12ea25c9-8f8e-0c39-cf60-cac927861df2"><p id="_0ffc52d9-8371-1abc-6205-8c560104a3d0" semx-id="_0ffc52d9-8371-1abc-6205-8c560104a3d0">ADEOfAbstractConstruction acts as a hook to define properties within an ADE that are to be added to AbstractConstruction.</p>
</td>
</tr><tr id="_0193180b-27a3-cda9-fcd3-92607ee03f09" semx-id="_0193180b-27a3-cda9-fcd3-92607ee03f09"><td id="_c583161f-f378-4d21-dc2a-89f941aed30f" valign="middle" align="left" semx-id="_c583161f-f378-4d21-dc2a-89f941aed30f"><p id="_03ce16a8-f426-8285-509d-78d8794a1af0" semx-id="_03ce16a8-f426-8285-509d-78d8794a1af0"><xref target="section-EAID_8BE81A2C_215F_4b43_BD0A_45A4A549413F" id="_4de04760-4685-d28a-7020-54cc1b17ffa1">ADEOfAbstractConstructionSurface</xref><fmt-xref target="section-EAID_8BE81A2C_215F_4b43_BD0A_45A4A549413F">ADEOfAbstractConstructionSurface</fmt-xref> «DataType»</p>
</td>
<td id="_1da4a954-959a-065a-189a-e0c6d661087c" valign="middle" align="left" semx-id="_1da4a954-959a-065a-189a-e0c6d661087c"><p id="_00c19dd8-f0eb-6612-cb95-d3ad87aa87ec" semx-id="_00c19dd8-f0eb-6612-cb95-d3ad87aa87ec">ADEOfAbstractConstructionSurface acts as a hook to define properties within an ADE that are to be added to AbstractConstructionSurface.</p>
</td>
</tr><tr id="_f352f270-6067-b499-6e49-dfd62ca82731" semx-id="_f352f270-6067-b499-6e49-dfd62ca82731"><td id="_f486066f-4990-aba1-f8de-6efe6fd8543d" valign="middle" align="left" semx-id="_f486066f-4990-aba1-f8de-6efe6fd8543d"><p id="_6625a877-5788-c1e5-c7ee-db59413ac84b" semx-id="_6625a877-5788-c1e5-c7ee-db59413ac84b"><xref target="section-EAID_85D5915A_4A27_4be6_994E_E2B345ADB379" id="_c949039c-87b9-e8d0-b6fb-a4eceac8b984">ADEOfAbstractConstructiveElement</xref><fmt-xref target="section-EAID_85D5915A_4A27_4be6_994E_E2B345ADB379">ADEOfAbstractConstructiveElement</fmt-xref> «DataType»</p>
</td>
