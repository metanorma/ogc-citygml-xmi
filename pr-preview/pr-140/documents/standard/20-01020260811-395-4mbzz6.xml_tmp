<title id="_62715a59-8aa8-8195-f012-186ba27125aa" semx-id="_eaaba09b-17f6-cf40-6d68-d59c965b9518">BuildingRoom</title><fmt-title depth="4" id="_130f070c-d9bb-a9da-bc3a-a03b15149b91"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>17<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>8<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span><semx element="title" source="_62715a59-8aa8-8195-f012-186ba27125aa">BuildingRoom</semx></fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>17<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>8</fmt-xref-label>
