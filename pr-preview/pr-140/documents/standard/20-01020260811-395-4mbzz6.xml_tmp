<term id="term-GM_MultiPrimitive" anchor="term-GM_MultiPrimitive" semx-id="_2cf2d1b8-ea92-5773-45c6-0ef91a032b65" autonum="B.1.2.23"><fmt-name id="_bf9e4eab-dbb2-5f51-caa0-6055942add04"><span class="fmt-caption-label">B<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>23<span class="fmt-autonum-delim">.</span></span></fmt-name><fmt-xref-label><span class="fmt-element-name">Annex</span> B<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>2<span class="fmt-autonum-delim">.</span>23</fmt-xref-label><preferred id="_e2cad17f-2ddd-21a1-9350-26551481a861"><expression>
