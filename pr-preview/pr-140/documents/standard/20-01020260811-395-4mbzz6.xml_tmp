<title language="en" script="Latn" type="title-main">OGC 3D Tiles Specification 1.0</title>

  
<title language="en" script="Latn" type="main">OGC 3D Tiles Specification 1.0</title>

  <uri type="src">http://www.opengis.net/doc/CS/3DTiles/1.0</uri>
  <uri type="html">https://docs.ogc.org/cs/18-053r2/18-053r2.html</uri><docidentifier type="metanorma-ordinal">[1]</docidentifier>
