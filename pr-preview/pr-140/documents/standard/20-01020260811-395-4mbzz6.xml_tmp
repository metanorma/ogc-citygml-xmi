<td id="_9cc886aa-44bc-3919-f431-f3dae1f49610" valign="middle" align="left" semx-id="_9cc886aa-44bc-3919-f431-f3dae1f49610"><sourcecode id="_9418e5e4-8b65-e07a-489e-0e0640e0f1b8" lang="ocl" linenums="true" semx-id="_9418e5e4-8b65-e07a-489e-0e0640e0f1b8"><body>boundary().isEmpty() = isCycle() (Invariant):</body><fmt-sourcecode lang="ocl" linenums="true" semx-id="_9418e5e4-8b65-e07a-489e-0e0640e0f1b8" id="_2917b17c-96ba-c896-0037-2df6b1cb42a1"><table class="rouge-line-table"><tbody><tr id="_9418e5e4-8b65-e07a-489e-0e0640e0f1b8_line-1" class="lineno"><td class="rouge-gutter gl" style="-moz-user-select: none;-ms-user-select: none;-webkit-user-select: none;user-select: none;"><pre>1</pre></td><td class="rouge-code"><sourcecode><span class="n">boundary</span><span class="p">().</span><span class="nf">isEmpty</span><span class="p">()</span> <span class="o">=</span> <span class="n">isCycle</span><span class="p">()</span> <span class="p">(</span><span class="n">Invariant</span><span class="p">):</span></sourcecode></td></tr></tbody></table></fmt-sourcecode></sourcecode> </td>
