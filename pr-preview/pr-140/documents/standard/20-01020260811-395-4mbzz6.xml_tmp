<term id="term-application-schema" anchor="term-application-schema" semx-id="_66d18a71-8196-269b-6e09-55b68f37b7af"><fmt-name id="_41e0a9db-0567-f996-f47a-abd2681e0594"><span class="fmt-caption-label">4<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4<span class="fmt-autonum-delim">.</span></span></fmt-name><fmt-xref-label><span class="fmt-element-name">Clause</span> 4<span class="fmt-autonum-delim">.</span>1<span class="fmt-autonum-delim">.</span>4</fmt-xref-label><preferred id="_29408793-23e8-90c7-16ae-07bf930b931a"><expression>
