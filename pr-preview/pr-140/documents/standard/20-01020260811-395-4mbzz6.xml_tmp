</td>
</tr><tr id="_447ea41d-9961-e793-656e-301e5779b8b1" semx-id="_447ea41d-9961-e793-656e-301e5779b8b1"><th id="_f0c3bc84-fd6a-ecd5-afa4-170298947c5a" valign="middle" align="left" semx-id="_f0c3bc84-fd6a-ecd5-afa4-170298947c5a">Constraint:</th>
<td id="_5ff0bd53-2159-8143-b03c-89d236f63e24" valign="middle" align="left" semx-id="_5ff0bd53-2159-8143-b03c-89d236f63e24"><sourcecode id="_0e1aa591-b99d-827b-4520-36d0ebc74372" lang="ocl" linenums="true" semx-id="_0e1aa591-b99d-827b-4520-36d0ebc74372"><body>dimension() &gt;  boundary().dimension (Invariant):</body><fmt-sourcecode lang="ocl" linenums="true" semx-id="_0e1aa591-b99d-827b-4520-36d0ebc74372" id="_091d6b4e-6388-6129-4e50-8bc9409cbac9"><table class="rouge-line-table"><tbody><tr id="_0e1aa591-b99d-827b-4520-36d0ebc74372_line-1" class="lineno"><td class="rouge-gutter gl" style="-moz-user-select: none;-ms-user-select: none;-webkit-user-select: none;user-select: none;"><pre>1</pre></td><td class="rouge-code"><sourcecode><span class="n">dimension</span><span class="p">()</span> <span class="o">&gt;</span>  <span class="n">boundary</span><span class="p">().</span><span class="n">dimension</span> <span class="p">(</span><span class="n">Invariant</span><span class="p">):</span></sourcecode></td></tr></tbody></table></fmt-sourcecode></sourcecode> </td>
