</td>
</tr><tr id="_e36ce0d2-c168-77b8-a86e-86eb0400ccf7" semx-id="_e36ce0d2-c168-77b8-a86e-86eb0400ccf7"><td id="_e12d672a-1746-c8d9-b891-0cf33881dba2" valign="middle" align="left" semx-id="_e12d672a-1746-c8d9-b891-0cf33881dba2"><p id="_afcfee23-9df7-1a52-073b-523cd8b4aebb" semx-id="_afcfee23-9df7-1a52-073b-523cd8b4aebb"><xref target="section-EAID_80E36981_3017_412f_BE42_5362EC08F2E3" id="_2f2e93be-4cef-b285-6a54-ed6055814b68">ADEOfAbstractFurniture</xref><fmt-xref target="section-EAID_80E36981_3017_412f_BE42_5362EC08F2E3">ADEOfAbstractFurniture</fmt-xref> «DataType»</p>
