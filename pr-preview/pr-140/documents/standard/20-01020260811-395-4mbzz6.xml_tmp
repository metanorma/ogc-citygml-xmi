<td id="_07aa70b1-f6e0-d8cb-7b61-607b34e8532e" valign="middle" align="left" semx-id="_07aa70b1-f6e0-d8cb-7b61-607b34e8532e"><ul id="_06f129d1-76ce-f452-3dbb-b090d393d834" semx-id="_06f129d1-76ce-f452-3dbb-b090d393d834"><li id="_78c089ee-291d-1efd-6d92-c3571718ef78"><fmt-name id="_273bed8d-c6ce-be9d-30b4-f288f6c82235">•</fmt-name><p id="_b3e7c181-d863-c111-cf8a-0c9c95869689" semx-id="_b3e7c181-d863-c111-cf8a-0c9c95869689">Core::AbstractSpaceBoundary and the subclasses:</p>
<ul id="_f7ee9ba0-45af-790b-d14f-328abc498415" semx-id="_f7ee9ba0-45af-790b-d14f-328abc498415"><li id="_c8a92284-39e3-f565-fc86-6639e26addcb"><fmt-name id="_48d04654-7dcc-e49e-f596-9fd7f47137d3">•</fmt-name><p id="_081d3837-5181-f629-2e2c-1b0d2d18ff53" semx-id="_081d3837-5181-f629-2e2c-1b0d2d18ff53">Core::AbstractThematicSurface,</p>
</li>
