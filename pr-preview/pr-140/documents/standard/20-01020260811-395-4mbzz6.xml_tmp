</tr><tr id="_9b30de92-2d48-be2f-9b9f-be5e800e0391" semx-id="_9b30de92-2d48-be2f-9b9f-be5e800e0391"><td id="_6ffc2181-349a-fd77-c9f2-ccee243f47fa" valign="middle" align="left" semx-id="_6ffc2181-349a-fd77-c9f2-ccee243f47fa"><p id="_f978abb1-3540-1359-9077-f400dcfcee41" semx-id="_f978abb1-3540-1359-9077-f400dcfcee41">AbstractSpace</p>
</td>
