<clause id="_b87a338f-2bdf-46ec-c51e-5238ebd610a7" obligation="normative" semx-id="_b87a338f-2bdf-46ec-c51e-5238ebd610a7">
<title id="_6f1d5441-2472-869f-8a77-ab12b5823016" semx-id="_838364fc-8443-fa3d-9415-1eb4085fb8d1">Enumerations</title><fmt-title depth="3" id="_7c8a280c-e46b-002c-53c3-71a6b61e4ccb"><span class="fmt-caption-label">8<span class="fmt-autonum-delim">.</span>18<span class="fmt-autonum-delim">.</span>6<span class="fmt-autonum-delim">.</span></span><span class="fmt-caption-delim"><tab/></span><semx element="title" source="_6f1d5441-2472-869f-8a77-ab12b5823016">Enumerations</semx></fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 8<span class="fmt-autonum-delim">.</span>18<span class="fmt-autonum-delim">.</span>6</fmt-xref-label>
<p id="_5f6d9b61-9dd0-17dc-bac0-1eb037a06c9d" semx-id="_5f6d9b61-9dd0-17dc-bac0-1eb037a06c9d">None.</p>
